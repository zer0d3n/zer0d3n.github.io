#!/usr/bin/env bash
# Blocks the commit if gitleaks finds a secret in what you are about to commit.
# Enable it once per clone:  git config core.hooksPath tools/hooks
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (github.com/gitleaks/gitleaks/releases)." >&2
  echo "pre-commit: install it or disable the hook with: git config --unset core.hooksPath" >&2
  exit 1
fi

# gitleaks 8.19+ uses «gitleaks git --pre-commit»; older versions use «gitleaks protect».
if gitleaks git --help >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner
else
  gitleaks protect --staged --redact --no-banner
fi
